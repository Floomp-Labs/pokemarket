# Optional: raises rate limits (register at https://dev.pokemontcg.io/)
POKEMONTCG_API_KEY=
POLL_INTERVAL_SECONDS=900
ALERT_PCT_THRESHOLD=4
ALERT_Z_THRESHOLD=1.75
ALERT_COOLDOWN_MINUTES=60
# pct move in any single PSA grade that triggers a graded-price alert
GRADE_ALERT_PCT_THRESHOLD=6
# cross-source price gap (%) that triggers a source-spread alert
ALERT_SPREAD_PCT_THRESHOLD=5
SPREAD_COOLDOWN_MINUTES=720
# US-vs-EU gap (%, Cardmarket FX-adjusted) that triggers a regional alert
REGIONAL_SPREAD_PCT_THRESHOLD=25
EUR_USD_RATE=1.08
# Extra comma-separated frontend origins allowed to call the API.
# Vercel deploys (*.vercel.app) and localhost:5173 are always allowed.
# CORS_ORIGINS=https://pokemarket.vercel.app
